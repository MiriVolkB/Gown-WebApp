generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Client {
  id           Int           @id @default(autoincrement())
  name         String
  email        String?
  phone        String
  WeddingDate  DateTime?
  Recommended  String?
  notes        String?
  createdAt    DateTime      @default(now())
  dueDate      DateTime?     @map("needGownBy")

  // ✅ ADD THESE TWO LINES:
  ownerId         String?   // Notice the '?' makes it optional for now
  owner           User?     @relation(fields: [ownerId], references: [id])
  appointments Appointment[]
  payments     Payment[]
  projects     Project[]
}

model Measurement {
  id             Int      @id @default(autoincrement())
  date           DateTime @default(now())
  Bust           Float
  waist          Float
  Hips           Float
  ShirtLength    Float
  SkirtLength    Float
  SleeveLength   Float
  SleeveWidth    Float
  ShoulderToBust Float
  notes          String?
  projectId      Int
  project        Project  @relation(fields: [projectId], references: [id])
}

model Appointment {
  id              Int      @id @default(autoincrement())
  clientId        Int
  notes           String?
  createdAt       DateTime @default(now())
  durationMinutes Int
  end             DateTime
  serviceId       Int
  start           DateTime
  status          String   @default("SCHEDULED")
  updatedAt       DateTime @updatedAt
  date            DateTime
  client          Client   @relation(fields: [clientId], references: [id])
  service         Service  @relation(fields: [serviceId], references: [id])
}

model Service {
  id                 Int           @id @default(autoincrement())
  name               String
  defaultDurationMin Int
  color              String?
  active             Boolean       @default(true)
  appointments       Appointment[]
}

model Project {
  id           Int           @id @default(autoincrement())
  clientId     Int
  memberName   String
  orderType    OrderType     @default(RENTAL)
  price        Float
  isPickedUp   Boolean       @default(false)
  expenses     Expense[]
  measurements Measurement[]
  client       Client        @relation(fields: [clientId], references: [id])
}

model Expense {
  id        Int      @id @default(autoincrement())
  projectId Int
  type      String
  amount    Float
  date      DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id])
}

model Payment {
  id       Int      @id @default(autoincrement())
  clientId Int
  amount   Float
  date     DateTime @default(now())
  note     String?
  method   String   @default("cash")
  client   Client   @relation(fields: [clientId], references: [id])
}

enum OrderType {
  CUSTOM_MAKE
  RENTAL
  CUSTOM_MAKE_RENTAL
}

// Add this to the bottom:
model User {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String
  role         String   @default("GUEST") // e.g., OWNER, SECRETARY, GUEST
  createdAt    DateTime @default(now())

  // ✅ ADD THIS: A user can own many clients
  clients      Client[]
}